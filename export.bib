   year = {2008}
}
@misc{Sanchez2008,
   abstract = {The cross-cultural literature is reviewed and integrated together with attitude theories, thereby outlining a model through which certain values influence the intervening variables that ultimately lead managers to tolerate employee bribery. The case of Latin America is employed to illustrate how regionally dominant cultural values may shape managers' attitudes, subjective norms, and perceived behavioral control, which in turn affect tolerance of employee bribery. A series of research propositions and practical recommendations are derived from the model. © 2007 Springer Science+Business Media B.V.},
   author = {Juan I. Sanchez and Carolina Gomez and Guillermo Wated},
   doi = {10.1007/s10551-007-9623-x},
