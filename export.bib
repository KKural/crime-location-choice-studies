   keywords = {Foreign Corrupt Practices Act,bribery,ethics training,international business},
   month = {9},
   pages = {333-348},
   publisher = {Taylor \& Francis Group},
   title = {Perception and Understanding of Bribery in International Business},
   volume = {22},
   url = {https://www.tandfonline.com/doi/abs/10.1080/10508422.2012.706140},
   year = {2012}
}
@article{Elahi2013,
   abstract = {This study attempts to find out Bangladeshi journalists' attitudes, perceptions, and practices about ethical dilemmas, particularly those involving conflicts of interest. Based on a survey of 333 Dhaka-based journalists, in-depth interviews, and focus group discussions, the study found that journalists' ethical standards are poor and that many indulge in corrupt practices. Their acceptance of corruption may be related to the country's general culture of corruption and ignorance of ethical issues. Professional behavior may be improved by introducing codes of ethics and professional ethics education. © 2013 Copyright Taylor and Francis Group, LLC.},
   author = {Manzur Elahi},
   doi = {10.1080/08900523.2013.798137;SUBPAGE:STRING:ABSTRACT;WGROUP:STRING:PUBLICATION},
